<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:background="@drawable/bg_weather_sunny"
    tools:context=".presentation.weather.weather_warning_list.WeatherWarningListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_weather_warning_last_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_gravity="center_horizontal"
            android:text="Waktu pemutakhiran data: Fri, 14 Aug 2026 02:30:10 +0000"
            android:textColor="@color/primary_text"
            android:background="@drawable/bg_badge_soft"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textSize="@dimen/text_size_body_medium"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_weather_warning_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"/>

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>